# Copy this file to .env and fill in your real values.

# Port the backend listens on.
PORT=8000

# FREE-WILi board over USB serial. Blank = no board connected; "auto" = find
# it by USB ID; or a port such as COM4. Run the backend with WINDOWS Python
# (py backend/main.py): WSL can't see the board's COM ports.
DEVICE_ADDRESS=

# How long a breathing session lasts on the board, in seconds.
INTERVENE_DURATION_S=120
