# Copy this file to .env and fill in your real values.

# FinchNode sandbox API key (starts with ck_test_)
FINCHNODE_API_KEY=ck_test_your_key_here

# FinchNode subject ID for the synthetic sandbox patient (u_...)
FINCHNODE_SUBJECT=u_your_subject_here

# Optional: sandbox source ID if the patient has multiple sources.
# Example: northstar-health, quillhaven-medical
FINCHNODE_SANDBOX_SOURCE=

# Base URL for the FinchNode API (only change if you are using a proxy).
FINCHNODE_API_URL=https://api.finchnode.com/api/v1

# Port the backend listens on. Set to 800 if your vision layer really sends
# webhooks to http://127.0.0.1:800/api/panic.
PORT=8000

# Local FREE-WILi hardware intervention URL
HARDWARE_IP_URL=http://192.168.1.100/trigger
